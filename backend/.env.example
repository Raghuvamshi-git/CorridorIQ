# ==========================================
# CorridorIQ Backend Environment Configuration
# ==========================================

# Database Configuration
# Format for MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# In case MySQL is not running locally, SQLite fallback is supported: sqlite:///./corridoriq.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/corridoriq_db
DB_FALLBACK_TO_SQLITE=true

# Google Gemini API
# Provide your Gemini API Key here (or via system environment variable GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

